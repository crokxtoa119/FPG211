{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/usage",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/usage/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Pricing",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Pricing/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pricing",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pricing/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/settings",
      "destination": "/settings/index.html"
    },
    {
      "source": "/accessibility",
      "destination": "/accessibility/index.html"
    },
    {
      "source": "/activity",
      "destination": "/activity/index.html"
    },
    {
      "source": "/500",
      "destination": "/500/index.html"
    },
    {
      "source": "/Creator",
      "destination": "/Creator/index.html"
    },
    {
      "source": "/Bio",
      "destination": "/Bio/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/About",
      "destination": "/about/index.html"
    },
    {
      "source": "/FAQ",
      "destination": "/FAQ/index.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback/index.html"
    },
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/search",
      "destination": "/search/index.html"
    },
    {
      "source": "/license",
      "destination": "/license/index.html"
    },
    {
      "source": "/sitemap",
      "destination": "/sitemap/index.html"
    },
    {
      "source": "/trust",
      "destination": "/trust/index.html"
    },
    {
      "source": "/status",
      "destination": "/status/index.html"
    },
    {
      "source": "/security",
      "destination": "/security/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/updates",
      "destination": "/updates/index.html"
    },
    {
      "source": "/coming-soon",
      "destination": "/coming-soon/index.html"
    },
    {
      "source": "/maintenance",
      "destination": "/maintenance/index.html"
    },
    {
      "source": "/offline",
      "destination": "/offline/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-rkqJqpPptw4LzSMukonArid33/2Ji3nbCLzufeDLZ6M=' 'sha256-63tCkTRDEaKaMybIh6AoIAMnfQ19mzfVdRyaeI5V2mQ=' 'sha256-VeXdAXRJ35cxUSk4uQfWW4jd3yVxfNc6LYxrij/xqCs=' 'sha256-5Y7sBhzx2vGyzEdMcr17E/oysyzWwbHichIquSuQuSE=' 'sha256-UCDh0V8eFmmnug34SP8ji6x90cZwhry8gkVJ1mtigYI=' https://www.gstatic.com https://apis.google.com https://giscus.app https://vercel.live; style-src 'self' 'unsafe-inline' https://giscus.app https://vercel.live; img-src 'self' data: blob: https:; font-src 'self' data: https://vercel.live https://assets.vercel.com; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://www.gstatic.com https://vercel.live wss://ws-us3.pusher.com; frame-src https://fpg-s-project.firebaseapp.com https://accounts.google.com https://giscus.app https://vercel.live; worker-src 'self'; manifest-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
